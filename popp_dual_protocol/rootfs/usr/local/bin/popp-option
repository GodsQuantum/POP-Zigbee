#!/usr/bin/env python3
import json
import sys
from pathlib import Path

if len(sys.argv) < 2:
    raise SystemExit("usage: popp-option KEY [DEFAULT]")
key = sys.argv[1]
default = sys.argv[2] if len(sys.argv) > 2 else None
try:
    data = json.loads(Path("/data/options.json").read_text())
except (OSError, json.JSONDecodeError):
    data = {}
value = data.get(key, default)
if value is None:
    raise SystemExit(f"missing required option: {key}")
if isinstance(value, bool):
    print("true" if value else "false")
else:
    print(value)
